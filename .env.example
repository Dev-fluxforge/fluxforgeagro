# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet or production site is hosted.
APP_URL="https://fluxforge.ng"

# PORT: Server listening port (default 3000 in dev, 4000/8080 in production)
PORT="3000"

# DATABASE_URL: PostgreSQL connection string (Railway, Render, Supabase, Neon)
# e.g., postgresql://postgres:password@junction.proxy.rlwy.net:5432/railway
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxforge_agro"

# JWT_SECRET: Cryptographic secret key used to sign and verify operator sessions
JWT_SECRET="fluxforge_saki_agro_secret_key_2026_change_in_production"

# ADMIN AUTHENTICATION CREDENTIALS (Operator backoffice login)
ADMIN_EMAIL="admin@fluxforge.ng"
ADMIN_PASSWORD="saki-agro-2026"

# CLOUDINARY CONFIGURATION (For image & field dispatch media uploads)
CLOUDINARY_CLOUD_NAME="fluxforge-agro"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://your_api_key:your_api_secret@fluxforge-agro"

